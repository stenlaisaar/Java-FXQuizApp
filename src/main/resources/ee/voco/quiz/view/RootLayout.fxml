<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ee.voco.quiz.view.RootLayoutController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="Quiz">
                    <items>
                        <MenuItem onAction="#handleRestart" text="Alusta uuesti" />
                        <MenuItem onAction="#handleExit" text="Välju" />
                    </items>
                </Menu>
                <Menu text="Abi">
                    <items>
                        <MenuItem onAction="#handleAbout" text="Programmist" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
</BorderPane>